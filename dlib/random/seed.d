module dlib.random.seed;

import core.stdc.stdlib;
import core.stdc.time;
import core.thread.osthread: getpid;

/**
 * Simple seed based on the system time and process ID.
 */
ulong seed()
{
    // Collect seed material
    ulong a = cast(ulong)clock();
    ulong b = cast(ulong)time(null);
    ulong c = cast(ulong)getpid();
    ulong d = cast(size_t)&seed;

    // Mix via xor-shift-multiply
    return fmix64(a ^ fmix64(b ^ fmix64(c ^ d)));
}

/**
 * 64-bit mix from MurmurHash3.
 */
ulong fmix64(ulong k) pure nothrow @safe @nogc
{
    k ^= k >> 33;
    k *= 0xff51afd7ed558ccdUL;
    k ^= k >> 33;
    k *= 0xc4ceb9fe1a85ec53UL;
    k ^= k >> 33;
    return k;
}

/**
 * Bob Jenkins' 96 bit mix function.
 */
ulong mix(ulong a, ulong b, ulong c) pure nothrow @safe @nogc
{
    a=a-b;  a=a-c;  a=a^(c >> 13);
    b=b-c;  b=b-a;  b=b^(a << 8);
    c=c-a;  c=c-b;  c=c^(b >> 13);
    a=a-b;  a=a-c;  a=a^(c >> 12);
    b=b-c;  b=b-a;  b=b^(a << 16);
    c=c-a;  c=c-b;  c=c^(b >> 5);
    a=a-b;  a=a-c;  a=a^(c >> 3);
    b=b-c;  b=b-a;  b=b^(a << 10);
    c=c-a;  c=c-b;  c=c^(b >> 15);
    return c;
}
