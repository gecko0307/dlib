/**
 * Ziggurat algorithm
 *
 * Description:
 * Fast pseudo-random number generator that samples Gaussian distribution
 * in single-precision floats.
 *
 * Copyright: Timur Gafarov 2026.
 * License: $(LINK2 boost.org/LICENSE_1_0.txt, Boost License 1.0).
 * Authors: Timur Gafarov
 */
module dlib.random.ziggurat;

import dlib.math.base;
import dlib.math.utils;

enum ZIG_LAYERS = 128;

// The precomputed volume of each slice for N=128 layers
enum double ZIG_R = 3.442619855899;
enum double ZIG_V = 9.91256303526217e-3;

enum double UINT32_MAX_P1 = 4294967296.0; // 2^32

// Lookup tables
private __gshared
{
    uint[ZIG_LAYERS]  k_table;
    float[ZIG_LAYERS] w_table;
    float[ZIG_LAYERS] f_table;
}

// State
private __gshared
{
    uint xorshift32_state = 123456789;
}

/// A standard 32-bit Xorshift PRNG to supply uniform random integers quickly.
uint xorshift32() @nogc nothrow
{
    uint x = xorshift32_state;
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    return xorshift32_state = x;
}

/// Probability Density Function for standard normal distribution.
double pdfGaussian(double x) @nogc nothrow pure
{
    return exp(-0.5f * x * x);
}

/// Computes table parameters. Run this exactly once before calling the generator.
void init(uint seed) @nogc nothrow
{
    xorshift32_state = seed;
    
    double q = ZIG_V / pdfGaussian(ZIG_R);

    // Set up the base layer (Layer 0) containing the infinite tail
    k_table[0] = cast(uint)((ZIG_R / q) * UINT32_MAX_P1);
    w_table[0] = cast(float)(q / UINT32_MAX_P1);
    f_table[0] = cast(float)pdfGaussian(ZIG_R);

    // Set up the intermediate horizontal rectangles
    double xPrev = ZIG_R;
    for (uint i = 1; i < ZIG_LAYERS - 1; i++)
    {
        double xCurr = sqrt(-2.0 * log(ZIG_V / xPrev + pdfGaussian(xPrev)));
        k_table[i] = cast(uint)((xCurr / xPrev) * UINT32_MAX_P1);
        w_table[i] = cast(float)(xPrev / UINT32_MAX_P1);
        f_table[i] = cast(float)pdfGaussian(xCurr);
        xPrev = xCurr;
    }

    // Top layer (Layer 127)
    k_table[ZIG_LAYERS - 1] = 0;
    w_table[ZIG_LAYERS - 1] = cast(float)(xPrev / UINT32_MAX_P1);
    f_table[ZIG_LAYERS - 1] = 1.0f;
}

/// The core tail fallback. Called strictly when a sample lands in the bottom-most layer's tail boundary.
private float tail(int sign) @nogc nothrow
{
    float x, y;
    do
    {
        // Sample from the exponential tail distribution
        x = -log(cast(float)(cast(double)xorshift32() / UINT32_MAX_P1)) / ZIG_R;
        y = -log(cast(float)(cast(double)xorshift32() / UINT32_MAX_P1));
    }
    while (y + y < x * x);
    
    return sign ? -(ZIG_R + x) : (ZIG_R + x);
}

/// Gaussian RNG.
float zigGaussian() @nogc nothrow
{
    while(true)
    {
        // Generate a fast uniform random bitstring
        uint u = xorshift32();
        
        // Extract layer index (last 7 bits) and sign bit
        int i = u & 0x7F; 
        int sign = (u >> 7) & 1;
        
        // Fast-path check: is the point inside the completely valid rectangle?
        if (u < k_table[i])
        {
            float x = cast(float)u * w_table[i];
            return sign ? -x : x;
        }

        // Slow path: handle the base layer tail
        if (i == 0)
            return tail(sign);

        // Slow path: rejection sampling for points near the curve edge
        float x = cast(float)u * w_table[i];
        if (f_table[i] + cast(float)(cast(double)xorshift32() / UINT32_MAX_P1) * (f_table[i-1] - f_table[i]) < pdfGaussian(x))
        {
            return sign ? -x : x;
        }
    }
}
