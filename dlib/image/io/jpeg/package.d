/**
 * Decode JPEG images
 *
 * Description:
 * Self-contained JPEG decoder supporting baseline and progressive Huffman JPEG.
 *
 * Copyright: Timur Gafarov 2015-2026.
 * License: $(LINK2 boost.org/LICENSE_1_0.txt, Boost License 1.0).
 * Authors: Timur Gafarov
 */
module dlib.image.io.jpeg;

import dlib.core.memory;
import dlib.core.stream;
import dlib.core.compound;
import dlib.filesystem.local;
import dlib.image.image;
import dlib.image.io.jpeg.image;
import dlib.image.io.jpeg.marker;
import dlib.image.io.jpeg.baseline;
import dlib.image.io.jpeg.progressive;

// Define "versions": ["JPEGDebug"] to see JPEG debug messages

/**
 * Load JPEG from file using local FileSystem.
 * Causes GC allocation.
 */
SuperImage loadJPEG(string filename)
{
    InputStream input = openForInput(filename);
    ubyte[] data = New!(ubyte[])(cast(size_t)input.size);
    input.fillArray(data);
    ArrayStream arrStrm = New!ArrayStream(data);
    auto img = loadJPEG(arrStrm);
    Delete(arrStrm);
    Delete(data);
    input.close();
    return img;
}

/**
 * Load JPEG from stream using default image factory.
 * Causes GC allocation.
 */
SuperImage loadJPEG(InputStream istrm)
{
    Compound!(SuperImage, string) res =
        loadJPEG(istrm, defaultImageFactory);
    if (res[0] is null)
        throw new Exception(res[1]);
    else
        return res[0];
}

/**
 * Load JPEG from stream using specified image factory.
 * GC-free.
 */
Compound!(SuperImage, string) loadJPEG(
    InputStream istrm,
    SuperImageFactory imgFac)
{
    JPEGImage jpg;
    SuperImage img = null;

    bool isProgressive = false;
    bool foundScan = false;
    while (istrm.readable)
    {
        JPEGMarkerType mt;
        auto res = readMarker(&jpg, istrm, &mt);
        if (res[0])
        {
            if (mt == JPEGMarkerType.SOF2)
                isProgressive = true;
            if (mt == JPEGMarkerType.SOS)
            {
                foundScan = true;
                break;
            }
            if (mt == JPEGMarkerType.SOF1)
            {
                jpg.free();
                return compound(img, "loadJPEG error: extended sequential JPEG is not supported");
            }
        }
        else
        {
            jpg.free();
            return compound(img, res[1]);
        }
    }

    if (!foundScan || jpg.frame.componentsNum == 0)
    {
        jpg.free();
        return compound(img, "loadJPEG error: missing frame or scan header");
    }

    Compound!(SuperImage, string) res;
    if (isProgressive)
        res = decodeProgressive(&jpg, istrm, imgFac);
    else
        res = decodeBaseline(&jpg, istrm, imgFac);
    jpg.free();
    return res;
}
