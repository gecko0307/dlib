/*
 * Progressive JPEG decoding
 *
 * A progressive file stores DCT coefficients of every block in several scans
 * (spectral selection and successive approximation), so, unlike in baseline
 * decoder, the whole set of coefficients is kept in memory, and dequantization,
 * IDCT and color conversion are performed after the last scan.
 */
module dlib.image.io.jpeg.progressive;

import std.format;

import dlib.core.memory;
import dlib.core.bitio;
import dlib.core.stream;
import dlib.core.compound;
import dlib.image.color;
import dlib.image.image;
import dlib.image.io.jpeg.image;
import dlib.image.io.jpeg.reading;
import dlib.image.io.jpeg.huffman;
import dlib.image.io.jpeg.marker;
import dlib.image.io.jpeg.bitstream;
import dlib.image.io.jpeg.mcu;
import dlib.image.io.jpeg.dct;

struct ProgressiveComponent
{
    ubyte id;
    uint h, v;               // Sampling factors
    uint blocksPerLine;      // Storage width in blocks (covers whole MCUs)
    uint blocksPerColumn;    // Storage height in blocks (covers whole MCUs)
    uint scanBlocksX;        // Number of blocks in a non-interleaved scan row
    uint scanBlocksY;        // Number of blocks in a non-interleaved scan column
    int[] coefs;             // 64 coefficients per block
    ubyte[] samples;         // Decoded plane (blocksPerLine * 8 pixels wide)

    int* block(uint bx, uint by)
    {
        return coefs.ptr + (cast(size_t)by * blocksPerLine + bx) * 64;
    }

    void free()
    {
        if (coefs.length)
        {
            Delete(coefs);
            coefs = null;
        }
        if (samples.length)
        {
            Delete(samples);
            samples = null;
        }
    }
}

/*
 * Reads bytes until a marker is found.
 * Returns marker code (0xFFxx), or 0 if the end of stream is reached
 */
ushort findMarker(InputStream istrm)
{
    while (istrm.readable)
    {
        ubyte b0 = istrm.readNumeric!ubyte;
        if (b0 != 0xFF)
            continue;
        ubyte b = 0xFF;
        while (b == 0xFF && istrm.readable)
            b = istrm.readNumeric!ubyte;
        if (b != 0x00 && b != 0xFF)
            return cast(ushort)(0xFF00 | b);
    }
    return 0;
}

/*
 * Bit reader for entropy-coded segments, plus decoders for the four kinds
 * of progressive blocks. Reading never goes past a marker: when one is hit,
 * it is saved in "marker" and zero bits are supplied from then on.
 */
struct ScanBitReader
{
    InputStream istrm;
    ubyte curByte = 0;
    int bitsLeft = 0;
    ushort marker = 0;
    uint eobrun = 0;
    bool failed = false;
    ubyte nextRestart = 0;

    void fill()
    {
        bitsLeft = 0;
        curByte = 0;
        if (marker != 0 || !istrm.readable)
        {
            failed = true;
            return;
        }

        ubyte b = istrm.readNumeric!ubyte;
        if (b == 0xFF)
        {
            ubyte b2 = 0xFF;
            while (b2 == 0xFF && istrm.readable)
                b2 = istrm.readNumeric!ubyte;
            if (b2 == 0x00)
                curByte = 0xFF; // Stuffed byte
            else if (b2 != 0xFF)
            {
                marker = cast(ushort)(0xFF00 | b2);
                failed = true;
                return;
            }
            else
            {
                failed = true;
                return;
            }
        }
        else
            curByte = b;
        bitsLeft = 8;
    }

    uint readBit()
    {
        if (bitsLeft == 0)
            fill();
        if (failed)
            return 0;
        bitsLeft--;
        return (curByte >> bitsLeft) & 1;
    }

    uint readBits(uint n)
    {
        uint v = 0;
        foreach(i; 0..n)
            v = (v << 1) | readBit();
        return v;
    }

    // Reads s bits and extends them to a signed value (T.81, F.2.2.1)
    int receiveExtend(uint s)
    {
        if (s == 0)
            return 0;
        int v = cast(int)readBits(s);
        if (v < (1 << (s - 1)))
            v += (-1 << s) + 1;
        return v;
    }

    bool readProgressiveValue(uint s, uint al, int* value)
    {
        int v = receiveExtend(s);
        if (failed)
            return false;
        *value = v * (1 << al);
        return true;
    }

    bool decodeSymbol(HuffmanTreeNode* node, ubyte* symbol)
    {
        if (node is null)
            return false;
        while (!node.isLeaf)
        {
            if (readBit())
                node = node.right;
            else
                node = node.left;
            if (node is null || failed)
                return false;
        }
        *symbol = node.ch;
        return true;
    }

    // Consumes restart marker, resets decoder state
    bool restart()
    {
        bitsLeft = 0;
        if (marker == 0)
            marker = findMarker(istrm);
        if (eobrun != 0 || marker != 0xFFD0 + nextRestart)
            return false;
        marker = 0;
        eobrun = 0;
        nextRestart = (nextRestart + 1) & 7;
        failed = false;
        return true;
    }

    // Returns marker that follows the scan data
    ushort finish()
    {
        if (marker == 0)
            marker = findMarker(istrm);
        return marker;
    }

    bool decodeDCFirst(HuffmanTreeNode* dcTree, int* blk, int* pred, uint al)
    {
        ubyte s;
        if (!decodeSymbol(dcTree, &s) || s > 15)
            return false;
        *pred += receiveExtend(s);
        if (failed)
            return false;
        blk[0] = *pred * (1 << al);
        return true;
    }

    bool decodeDCRefine(int* blk, uint al)
    {
        if (readBit())
            blk[0] |= 1 << al;
        return !failed;
    }

    bool decodeACFirst(HuffmanTreeNode* acTree, int* blk, uint ss, uint se, uint al)
    {
        if (eobrun > 0)
        {
            eobrun--;
            return true;
        }

        uint k = ss;
        while (k <= se)
        {
            ubyte rs;
            if (!decodeSymbol(acTree, &rs))
                return false;
            uint r = rs >> 4;
            uint s = rs & 15;

            if (s == 0)
            {
                if (r < 15)
                {
                    // EOBn: this block and next (2^r - 1 + extra) blocks have no more coefficients
                    eobrun = (1 << r) - 1;
                    if (r > 0)
                        eobrun += readBits(r);
                        if (failed)
                            return false;
                    break;
                }
                k += 16; // ZRL
                if (k > se + 1)
                    return false;
            }
            else
            {
                k += r;
                if (k > se)
                    return false;
                if (!readProgressiveValue(s, al, &blk[k]))
                    return false;
                k++;
            }
        }
        return !failed;
    }

    // Reads correction bit for already nonzero coefficient
    void refineCoef(int* p, int p1)
    {
        if (readBit())
        {
            if ((*p & p1) == 0)
            {
                if (*p >= 0)
                    *p += p1;
                else
                    *p -= p1;
            }
        }
    }

    bool decodeACRefine(HuffmanTreeNode* acTree, int* blk, uint ss, uint se, uint al)
    {
        int p1 = 1 << al;
        uint k = ss;

        if (eobrun == 0)
        {
            for (; k <= se; k++)
            {
                ubyte rs;
                if (!decodeSymbol(acTree, &rs))
                    return false;
                int r = rs >> 4;
                int s = rs & 15;

                if (s != 0)
                {
                    if (s != 1)
                        return false;
                    s = readBit() ? p1 : -p1; // Value of newly nonzero coefficient
                    if (failed)
                        return false;
                }
                else if (r != 15)
                {
                    // EOBn
                    eobrun = 1 << r;
                    if (r > 0)
                        eobrun += readBits(r);
                    if (failed)
                        return false;
                    break;
                }

                // Skip r zero coefficients, refining nonzero ones on the way.
                // For ZRL (s = 0, r = 15) this skips 16 zeroes in total
                int zeroRun = r;
                bool inserted = false;
                bool runComplete = false;
                do
                {
                    int* p = blk + k;
                    if (*p != 0)
                        refineCoef(p, p1);
                    else
                    {
                        if (zeroRun == 0)
                        {
                            runComplete = true;
                            if (s != 0)
                            {
                                *p = s;
                                inserted = true;
                            }
                            break;
                        }
                        zeroRun--;
                    }
                    k++;
                }
                while (k <= se);

                if (!runComplete || (s != 0 && !inserted))
                    return false;
            }
        }

        if (eobrun > 0)
        {
            // Rest of the block: only correction bits
            for (; k <= se; k++)
            {
                if (blk[k] != 0)
                    refineCoef(blk + k, p1);
            }
            eobrun--;
        }

        return !failed;
    }
}

/*
 * Decodes one progressive scan (jpg.scan must be already read)
 * into coefficient buffers. Returns the marker that follows the scan.
 */
Compound!(bool, string) decodeProgressiveScan(
    JPEGImage* jpg,
    InputStream istrm,
    ProgressiveComponent[] comps,
    uint mcusX,
    uint mcusY,
    ushort* nextMarker)
{
    auto scan = &jpg.scan;
    const uint ss = scan.spectralSelectionStart;
    const uint se = scan.spectralSelectionEnd;
    const uint ah = scan.successiveApproximationBitHigh;
    const uint al = scan.successiveApproximationBitLow;

    if (scan.componentsNum < 1 || scan.componentsNum > comps.length)
        return compound(false, "loadJPEG error: illegal number of components in scan");
    if (ss == 0)
    {
        if (se != 0)
            return compound(false, "loadJPEG error: illegal spectral selection in DC scan");
    }
    else if (se < ss || se > 63 || scan.componentsNum != 1)
        return compound(false, "loadJPEG error: illegal spectral selection in AC scan");
    if (ah > 13 || al > 13)
        return compound(false, "loadJPEG error: illegal successive approximation");
    if (ah != 0 && ah != al + 1)
        return compound(false, "loadJPEG error: illegal successive approximation order");
    if (scan.components.length != scan.componentsNum)
        return compound(false, "loadJPEG error: incomplete scan header");

    // Find frame component and Huffman tables for each scan component
    size_t[4] ci;
    HuffmanTreeNode*[4] dcTrees;
    HuffmanTreeNode*[4] acTrees;
    foreach(i, ref sc; scan.components)
    {
        bool found = false;
        foreach(j, ref c; comps)
        {
            if (c.id == sc.id)
            {
                ci[i] = j;
                found = true;
                break;
            }
        }
        if (!found)
            return compound(false, "loadJPEG error: unknown component in scan");

        if (ss == 0 && ah == 0)
        {
            auto t = jpg.getHuffmanTable(0, sc.tableIdDC);
            if (t is null)
                return compound(false, "loadJPEG error: illegal DC table index in scan component");
            dcTrees[i] = t.huffmanTree;
        }
        if (ss > 0)
        {
            auto t = jpg.getHuffmanTable(1, sc.tableIdAC);
            if (t is null)
                return compound(false, "loadJPEG error: illegal AC table index in scan component");
            acTrees[i] = t.huffmanTree;
        }
    }

    ScanBitReader br;
    br.istrm = istrm;

    int[4] dcPred;
    uint mcuCount = 0;
    const uint restartInterval = jpg.restartInterval;

    // Called before each MCU
    bool handleRestart()
    {
        if (restartInterval > 0 && mcuCount > 0 && (mcuCount % restartInterval) == 0)
        {
            if (!br.restart())
                return false;
            dcPred[] = 0;
        }
        mcuCount++;
        return true;
    }

    bool decodeBlock(size_t i, int* blk)
    {
        if (ss == 0)
        {
            if (ah == 0)
                return br.decodeDCFirst(dcTrees[i], blk, &dcPred[i], al);
            br.decodeDCRefine(blk, al);
            return true;
        }
        else if (ah == 0)
            return br.decodeACFirst(acTrees[i], blk, ss, se, al);
        else
            return br.decodeACRefine(acTrees[i], blk, ss, se, al);
    }

    enum corruptData = "loadJPEG error: corrupt scan data";

    if (scan.componentsNum == 1)
    {
        // Non-interleaved scan: blocks of the component in raster order
        auto c = &comps[ci[0]];
        foreach(by; 0..c.scanBlocksY)
        foreach(bx; 0..c.scanBlocksX)
        {
            if (!handleRestart() || !decodeBlock(0, c.block(bx, by)))
                return compound(false, corruptData);
        }
    }
    else
    {
        // Interleaved scan: MCU by MCU
        foreach(my; 0..mcusY)
        foreach(mx; 0..mcusX)
        {
            if (!handleRestart())
                return compound(false, corruptData);

            foreach(i; 0..scan.componentsNum)
            {
                auto c = &comps[ci[i]];
                foreach(by; 0..c.v)
                foreach(bx; 0..c.h)
                {
                    if (!decodeBlock(i, c.block(mx * c.h + bx, my * c.v + by)))
                        return compound(false, corruptData);
                }
            }
        }
    }

    *nextMarker = br.finish();
    if (br.eobrun != 0)
        return compound(false, corruptData);
    return compound(true, "");
}

/*
 * Decodes all scans of a progressive JPEG and creates RGB image.
 * The first SOS marker should be already read
 */
Compound!(SuperImage, string) decodeProgressive(
    JPEGImage* jpg,
    InputStream istrm,
    SuperImageFactory imgFac)
{
    SuperImage img = null;
    ProgressiveComponent[] comps;

    Compound!(SuperImage, string) error(string errorMsg)
    {
        foreach(ref c; comps)
            c.free();
        if (comps.length)
        {
            Delete(comps);
            comps = null;
        }
        if (img)
        {
            img.free();
            img = null;
        }
        return compound(img, errorMsg);
    }

    auto frame = &jpg.frame;

    if (frame.precision != 8)
        return error("loadJPEG error: unsupported sample precision");
    if (frame.componentsNum != 1 && frame.componentsNum != 3)
        return error(format(
            "loadJPEG error: unsupported number of components: %s",
            frame.componentsNum));
    if (frame.width == 0 || frame.height == 0)
        return error("loadJPEG error: illegal image size");

    uint hmax = 1;
    uint vmax = 1;
    foreach(ref fc; frame.components)
    {
        if (fc.hSubsampling < 1 || fc.hSubsampling > 4 ||
            fc.vSubsampling < 1 || fc.vSubsampling > 4)
            return error("loadJPEG error: illegal sampling factors");
        if (fc.hSubsampling > hmax)
            hmax = fc.hSubsampling;
        if (fc.vSubsampling > vmax)
            vmax = fc.vSubsampling;
    }

    const uint mcusX = (frame.width + 8 * hmax - 1) / (8 * hmax);
    const uint mcusY = (frame.height + 8 * vmax - 1) / (8 * vmax);

    if (frame.components.length != frame.componentsNum)
        return error("loadJPEG error: incomplete frame header");

    comps = New!(ProgressiveComponent[])(frame.componentsNum);
    int[4][64] coefficientAl;
    foreach(k; 0..64)
        foreach(ci; 0..frame.componentsNum)
            coefficientAl[k][ci] = -1;
    foreach(i, ref c; comps)
    {
        auto fc = &frame.components[i];
        c.id = fc.id;
        c.h = fc.hSubsampling;
        c.v = fc.vSubsampling;
        c.blocksPerLine = mcusX * c.h;
        c.blocksPerColumn = mcusY * c.v;
        const uint compWidth = (frame.width * c.h + hmax - 1) / hmax;
        const uint compHeight = (frame.height * c.v + vmax - 1) / vmax;
        c.scanBlocksX = (compWidth + 7) / 8;
        c.scanBlocksY = (compHeight + 7) / 8;
        c.samples = null;
        c.coefs = New!(int[])(cast(size_t)c.blocksPerLine * c.blocksPerColumn * 64);
        c.coefs[] = 0;
    }

    foreach(i, ref fc; frame.components)
    foreach(j; 0..i)
        if (fc.id == frame.components[j].id)
            return error("loadJPEG error: duplicate frame component id");

    // Decode scans. Between them there may be DHT, DQT, DRI and other segments
    while (true)
    {
        size_t[4] scanComponentIndices;
        foreach(i, ref sc; jpg.scan.components)
        {
            bool found = false;
            foreach(ci, ref c; comps)
                if (c.id == sc.id)
                {
                    scanComponentIndices[i] = ci;
                    found = true;
                    break;
                }
            if (!found)
                return error("loadJPEG error: unknown component in scan");
            foreach(j; 0..i)
                if (jpg.scan.components[j].id == sc.id)
                    return error("loadJPEG error: duplicate component in scan");
        }

        const uint ss = jpg.scan.spectralSelectionStart;
        const uint se = jpg.scan.spectralSelectionEnd;
        const uint ah = jpg.scan.successiveApproximationBitHigh;
        const uint al = jpg.scan.successiveApproximationBitLow;
        if (ss <= se && se < 64)
        {
            foreach(i; 0..jpg.scan.componentsNum)
            foreach(k; ss..(se + 1))
            {
                const size_t ci = scanComponentIndices[i];
                if (ah == 0 ? coefficientAl[k][ci] != -1 : coefficientAl[k][ci] != ah)
                    return error("loadJPEG error: invalid progressive coefficient scan order");
            }
        }

        ushort marker = 0;
        auto sres = decodeProgressiveScan(jpg, istrm, comps, mcusX, mcusY, &marker);
        if (!sres[0])
            return error(sres[1]);

        if (ss <= se && se < 64)
            foreach(i; 0..jpg.scan.componentsNum)
            foreach(k; ss..(se + 1))
                coefficientAl[k][scanComponentIndices[i]] = cast(int)al;

        bool nextScan = false;
        while (!nextScan)
        {
            if (marker == 0)
                return error("loadJPEG error: unexpected end of progressive JPEG");
            else if (marker == 0xFFD9) // EOI
                break;
            else if (marker == 0xFFDA)
            {
                auto r = readSOS(jpg, istrm);
                if (!r[0])
                    return error(r[1]);
                nextScan = true;
            }
            else if (marker >= 0xFFC0 && marker <= 0xFFC2)
                return error("loadJPEG error: unexpected SOF marker");
            else
            {
                JPEGMarkerType mt;
                auto r = processMarker(jpg, istrm, &mt, marker);
                if (!r[0])
                    return error(r[1]);

                if (mt == JPEGMarkerType.Unknown && marker != 0xFF01)
                {
                    // Unrecognized marker segment: skip it
                    ushort len = istrm.readNumeric!ushort(Endian.Big);
                    if (len < 2)
                        return error("loadJPEG error: illegal marker segment length");
                    foreach(i; 0..(len - 2))
                        istrm.readNumeric!ubyte;
                }

                marker = findMarker(istrm);
            }
        }
        if (!nextScan)
            break;
    }

    // Dequantize, IDCT
    foreach(ci, ref c; comps)
    {
        auto qt = jpg.getQuantizationTable(frame.components[ci].dqtTableId);
        if (qt is null)
            return error("loadJPEG error: illegal DQT table index in progressive JPEG");
        if (qt.precision > 1 || qt.table.length < (qt.precision? 128 : 64))
            return error("loadJPEG error: illegal DQT table");

        int[64] q;
        foreach(k; 0..64)
        {
            if (qt.precision == 0)
                q[k] = qt.table[k];
            else
                q[k] = (qt.table[k * 2] << 8) | qt.table[k * 2 + 1];
        }

        const size_t planeWidth = c.blocksPerLine * 8;
        c.samples = New!(ubyte[])(planeWidth * c.blocksPerColumn * 8);

        foreach(by; 0..c.blocksPerColumn)
        foreach(bx; 0..c.blocksPerLine)
        {
            int* blk = c.block(bx, by);
            int[64] dctMatrix;
            foreach(k; 0..64)
                dctMatrix[dezigzag[k]] = blk[k] * q[k];
            idct64(dctMatrix.ptr);

            foreach(y; 0..8)
            foreach(x; 0..8)
            {
                int v = dctMatrix[y * 8 + x] + 128;
                if (v < 0)
                    v = 0;
                else if (v > 255)
                    v = 255;
                c.samples[(by * 8 + y) * planeWidth + bx * 8 + x] = cast(ubyte)v;
            }
        }
    }

    // Upsample chroma (nearest neighbor), convert YCbCr to RGB
    img = imgFac.createImage(frame.width, frame.height, 3, 8);

    size_t[3] rowOffset;
    foreach(y; 0..frame.height)
    {
        foreach(ci, ref c; comps)
            rowOffset[ci] = cast(size_t)(y * c.v / vmax) * c.blocksPerLine * 8;

        foreach(x; 0..frame.width)
        {
            float Y = comps[0].samples[rowOffset[0] + x * comps[0].h / hmax];
            Color4f col;
            if (comps.length == 3)
            {
                float Cb = comps[1].samples[rowOffset[1] + x * comps[1].h / hmax] - 128.0f;
                float Cr = comps[2].samples[rowOffset[2] + x * comps[2].h / hmax] - 128.0f;
                col.r = Y + 1.402f * Cr;
                col.g = Y - 0.34414f * Cb - 0.71414f * Cr;
                col.b = Y + 1.772f * Cb;
            }
            else
            {
                col.r = Y;
                col.g = Y;
                col.b = Y;
            }

            if (col.r < 0.0f) col.r = 0.0f; else if (col.r > 255.0f) col.r = 255.0f;
            if (col.g < 0.0f) col.g = 0.0f; else if (col.g > 255.0f) col.g = 255.0f;
            if (col.b < 0.0f) col.b = 0.0f; else if (col.b > 255.0f) col.b = 255.0f;
            col = col / 255.0f;
            col.a = 1.0f;
            img[x, y] = col;
        }
    }

    foreach(ref c; comps)
        c.free();
    Delete(comps);
    return compound(img, "");
}
