/**
 * Generic flat hash map.
 *
 * Copyright: Timur Gafarov 2026.
 * License: $(LINK2 boost.org/LICENSE_1_0.txt, Boost License 1.0).
 * Authors: Timur Gafarov
 */
module dlib.container.hashmap;

import std.traits;

import dlib.core.memory;
import dlib.core.ownership;
import dlib.hash.xxhash64;

enum XXHASH64_SEED = 42;

/**
 * An open-addressing hash map that stores data in a contiguous buffer. GC-free.
 * Works in near-constant time.
 * Insertion is 36x faster than dlib.container.dict and 1.7x faster than native AA.
 * Searching is 15x faster than dlib.container.dict and 1.6x faster than native AA.
 * For string-based access, xxHash64 is used.
 */
class FlatHashMap(T): Owner
{
   protected:
    struct Bucket
    {
        ulong key; // xxHash64 (0 = empty, ulong.max = tombstone)
        T value;   // Arbitrary raw pointer
    }

    Bucket[] buckets;
    size_t size;
    size_t capacity;

    enum size_t DEFAULT_CAPACITY = 512;
    enum float LOAD_FACTOR = 0.7f;
    enum ulong TOMBSTONE = ulong.max;

   public:
    
    /// Constructs a FlatHashMap.
    this(Owner owner)
    {
        super(owner);
        capacity = DEFAULT_CAPACITY;
        buckets = New!(Bucket[])(capacity);
    }

    ~this()
    {
        if (buckets.ptr)
            Delete(buckets);
    }
    
    /// Returns number of stored entries.
    size_t length() const @property
    {
        return size;
    }

    /// Insert. Returns true if new entry is inserted, false if it already exists.
    bool set(ulong key, T value, out T existingValue)
    {
        if (key == 0 || key == TOMBSTONE) key = 1;

        if (cast(float)size / cast(float)capacity >= LOAD_FACTOR)
        {
            resize(capacity * 2);
        }

        size_t index = cast(size_t)(key & (capacity - 1));
        size_t firstTombstoneIndex = size_t.max;

        while(true)
        {
            ulong currentKey = buckets[index].key;

            if (currentKey == 0) 
            {
                size_t targetIndex = (firstTombstoneIndex != size_t.max) ? firstTombstoneIndex : index;
                
                buckets[targetIndex].value = value;
                buckets[targetIndex].key = key;
                size++;
                existingValue = value;
                return true;
            }

            if (currentKey == TOMBSTONE)
            {
                if (firstTombstoneIndex == size_t.max)
                    firstTombstoneIndex = index;
            }
            else if (currentKey == key) 
            {
                existingValue = buckets[index].value;
                return false;
            }

            index = (index + 1) & (capacity - 1);
        }
    }

    /// Insert by string hash.
    bool set(string key, T value)
    {
        T existingValue;
        return set(xxHash64(key, XXHASH64_SEED), value, existingValue);
    }

    /// Lookup a value.
    T get(ulong key) const nothrow @nogc
    {
        if (key == 0 || key == TOMBSTONE) key = 1;

        size_t index = cast(size_t)(key & (capacity - 1));
        size_t start = index;

        while(true)
        {
            ulong currentKey = buckets[index].key;

            if (currentKey == key)
                return buckets[index].value;
            
            if (currentKey == 0)
            {
                static if (is(T == class) || isPointer!T)
                    return null;
                else
                    return T.init;
            }
            
            index = (index + 1) & (capacity - 1);
            if (index == start)
                break;
        }
        
        static if (is(T == class) || isPointer!T)
            return null;
        else
            return T.init;
    }
    
    /// Lookup a pointer.
    T* getPtr(ulong key) nothrow @nogc
    {
        if (key == 0 || key == TOMBSTONE) key = 1;

        size_t index = cast(size_t)(key & (capacity - 1));
        size_t start = index;

        while(true)
        {
            ulong currentKey = buckets[index].key;

            if (currentKey == key)
                return &buckets[index].value;
            
            if (currentKey == 0)
                return null;
            
            index = (index + 1) & (capacity - 1);
            if (index == start)
                break;
        }
        
        return null;
    }
    
    /// Lookup a value by string hash.
    T get(string key) const nothrow @nogc
    {
        return get(xxHash64(key, XXHASH64_SEED));
    }

    /// Bracket syntax to get a value by string hash.
    T opIndex(string key) const nothrow @nogc
    {
        return get(xxHash64(key, XXHASH64_SEED));
    }

    /// Bracket syntax to set or replace a value by string hash.
    T opIndexAssign(T value, string key)
    {
        T existingValue;
        set(xxHash64(key, XXHASH64_SEED), value, existingValue);
        return value;
    }
    
    /// "in" operator.
    T* opBinaryRight(string op)(string key) if (op == "in")
    {
        return getPtr(xxHash64(key, XXHASH64_SEED));
    }

    /// Removes an entry.
    void remove(ulong key) nothrow @nogc
    {
        if (key == 0 || key == TOMBSTONE) key = 1;

        size_t index = cast(size_t)(key & (capacity - 1));
        size_t start = index;

        while(true)
        {
            ulong currentKey = buckets[index].key;

            if (currentKey == key)
            {
                buckets[index].key = TOMBSTONE;
                static if (is(T == class) || isPointer!T)
                    buckets[index].value = null;
                else
                    buckets[index].value = T.init;
                size--;
                return;
            }
            if (currentKey == 0)
                return;

            index = (index + 1) & (capacity - 1);
            if (index == start)
                break;
        }
    }

    /// Removes an entry by string hash.
    void remove(string key) nothrow @nogc
    {
        remove(xxHash64(key, XXHASH64_SEED));
    }

    /// Removes all entries.
    void clear()
    {
        if (buckets.ptr)
            Delete(buckets);
        
        size = 0;
        capacity = DEFAULT_CAPACITY;
        buckets = New!(Bucket[])(capacity);
    }
    
    /// Applies an iterator delegate to all entries.
    int opApply(scope int delegate(ulong, T) dg)
    {
        int result = 0;
        foreach(ref b; buckets)
        {
            if (b.key != 0 && b.key != TOMBSTONE)
            {
                result = dg(b.key, b.value);
                if (result)
                    break;
            }
        }
        return result;
    }

   protected:
    void resize(size_t newCapacity)
    {
        auto oldBuckets = buckets;
        auto newBuckets = New!(Bucket[])(newCapacity);
        size_t newSize = 0;

        foreach(ref b; oldBuckets)
        {
            if (b.key != 0 && b.key != TOMBSTONE)
            {
                size_t index = cast(size_t)(b.key & (newCapacity - 1));
                while (newBuckets[index].key != 0)
                {
                    index = (index + 1) & (newCapacity - 1);
                }
                newBuckets[index].key = b.key;
                newBuckets[index].value = b.value;
                newSize++;
            }
        }

        capacity = newCapacity;
        size = newSize;
        buckets = newBuckets;

        Delete(oldBuckets);
    }
}

unittest
{
    auto hashMap = New!(FlatHashMap!int)(null);
    hashMap["foo"] = 50;
    hashMap["bar"] = 99;
    assert("foo" in hashMap);
    assert(hashMap["foo"] == 50);
    hashMap.remove("foo");
    assert(hashMap.length == 1);
    hashMap.clear();
    assert(hashMap.length == 0);
    Delete(hashMap);
}
