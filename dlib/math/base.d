/**
 * Optimized elementary mathematical functions.
 *
 * Description:
 * This is a direct replacement for std.math that implicitly uses LLVM intrinsics
 * instead of Phobos functions when possible for maximum performance.
 * Don't use both std.math and dlib.math.base without name qualification,
 * or you'll get "conflicting symbols" errors.
 *
 * Copyright: Timur Gafarov 2026.
 * License: $(LINK2 boost.org/LICENSE_1_0.txt, Boost License 1.0).
 * Authors: Timur Gafarov
 */
module dlib.math.base;

version(LDC)
{
    import ldc.intrinsics;
}

import std.math;

/*
 * Basic math constants
 */
enum double E           = 2.7182818284590452;
enum double PI          = 3.1415926535897932;
enum double HALFPI      = 1.5707963267948966; // PI/2
enum double QUARTPI     = 0.7853981633974483; // PI/4
enum double INVPI       = 0.3183098861837907; // 1/PI
enum double INVTWOPI    = 0.1591549430918953; // 1/2PI
enum double TWOPI       = 6.2831853071795865; // 2PI
enum double THREEHALFPI = 4.7123889803846899; // 3PI/2
enum double LN10        = 2.3025850929940457; // ln(10)
enum double LN2         = 0.6931471805599453; // ln(2)
enum double INVLN2      = 1.4426950408889634; // 1/ln(2)
enum double LOG2        = 0.3010299956639812; // log10(2)
enum double LOG2E       = 1.4426950408889634; // log2(e)
enum double LOG10E      = 0.4342944819032518; // log10(E)
enum double LOG2T       = 3.3219280948873623; // log2(10)
enum double SQRT2       = 1.4142135623730951; // sqrt(2)
enum double SQRT1_2     = 0.7071067811865476; // sqrt(1/2)

// std.math compatibility
alias PI_2 = HALFPI;
alias PI_4 = QUARTPI;
alias M_1_PI = INVPI;
enum double M_2_PI      = 0.6366197723675813; // 2/PI
enum double M_2_SQRTPI  = 1.1283791670955125; // 2/sqrt(PI)

/// Returns true is the input is NaN.
pragma(inline, true)
bool isNaN(T)(T x) pure nothrow @nogc
{
    return x != x;
}

/// Returns true is the input is infinity.
pragma(inline, true)
int isInfinity(T)(T x) pure nothrow @nogc
{
    return !isNaN(x) && isNaN(x - x);
}

/// Cotangent.
pragma(inline, true)
T ctg(T)(T x) pure nothrow @nogc
{
    return cos(x) / sin(x);
}

version(LDC)
{
    // Inverse square root via LLVM intrinsic.
    pragma(inline, true)
    float rsqrt(float number) pure nothrow @nogc
    {
        return 1.0f / llvm_sqrt(number);
    }
}
else
{
    // John Carmack's fast inverse square root, just for fun (a bit faster than std.math).
    pragma(inline, true)
    float rsqrt(float number) pure nothrow @nogc
    {
        uint i;
        float x2, y;
        const float threehalfs = 1.5f;
        x2 = number * 0.5f;
        y  = number;
        i  = *cast(uint*)&y;                  // evil floating point bit level hacking
        i  = 0x5f3759df - (i >> 1);           // what the fuck?
        y  = *cast(float*)&i;
        y  = y * (threehalfs - (x2 * y * y)); // 1st iteration
    //  y  = y * (threehalfs - (x2 * y * y)); // 2nd iteration, this can be removed
        return y;
    }
}

version(LDC)
{
    // Tangent via LLVM intrinsics.
    pragma(inline, true)
    T llvm_tan(T)(T x) pure nothrow @nogc
    {
        return llvm_sin(x) / llvm_cos(x);
    }
    
    // Use LLVM intrinsics if available, std.math otherwise
    
    // Algebraic
    alias abs       = std.math.abs;
    alias fabs      = llvm_fabs;
    alias sqrt      = llvm_sqrt;
    alias cbrt      = std.math.cbrt;
    alias hypot     = std.math.hypot;
    alias poly      = std.math.poly;
    alias nextPow2  = std.math.nextPow2;
    alias truncPow2 = std.math.truncPow2;
    
    // Trigonometry
    alias sin   = llvm_sin;
    alias cos   = llvm_cos;
    alias tan   = llvm_tan;
    alias asin  = std.math.asin;
    alias acos  = std.math.acos;
    alias atan  = std.math.atan;
    alias atan2 = std.math.atan2;
    alias sinh  = std.math.sinh;
    alias cosh  = std.math.cosh;
    alias tanh  = std.math.tanh;
    alias asinh = std.math.asinh;
    alias acosh = std.math.acosh;
    alias atanh = std.math.atanh;
    
    // Rounding
    alias ceil      = llvm_ceil;
    alias floor     = llvm_floor;
    alias round     = llvm_round;
    alias lround    = std.math.lround;
    alias trunc     = llvm_trunc;
    alias rint      = llvm_rint;
    alias lrint     = std.math.lrint;
    alias nearbyint = llvm_nearbyint;
    alias rndtol    = std.math.rndtol;
    alias quantize  = std.math.quantize;
    
    // Exponentiation & Logarithms
    alias pow    = llvm_pow;
    alias powmod = std.math.powmod;
    alias exp    = llvm_exp;
    alias exp2   = llvm_exp2;
    alias expm1  = std.math.expm1;
    alias ldexp  = std.math.ldexp;
    alias frexp  = std.math.frexp;
    alias log    = llvm_log;
    alias log2   = llvm_log2;
    alias log10  = llvm_log10;
    alias logb   = std.math.logb;
    alias ilogb  = std.math.ilogb;
    alias log1p  = std.math.log1p;
    alias scalbn = std.math.scalbn;
    
    // Remainder
    alias fmod      = std.math.fmod;
    alias modf      = std.math.modf;
    alias remainder = std.math.remainder;
    
    // Floating-point operations
    alias approxEqual   = std.math.approxEqual;
    alias feqrel        = std.math.feqrel;
    alias fdim          = std.math.fdim;
    alias fmax          = llvm_maxnum;
    alias fmin          = llvm_minnum;
    alias fma           = llvm_fma;
    alias isClose       = std.math.isClose;
    alias nextDown      = std.math.nextDown;
    alias nextUp        = std.math.nextUp;
    alias nextafter     = std.math.nextafter;
    alias NaN           = std.math.NaN;
    alias getNaNPayload = std.math.getNaNPayload;
    alias cmp           = std.math.cmp;
    
    // Introspection
    alias isFinite      = std.math.isFinite;
    alias isIdentical   = std.math.isIdentical;
    alias isNormal      = std.math.isNormal;
    alias isSubnormal   = std.math.isSubnormal;
    alias signbit       = std.math.signbit;
    alias sgn           = std.math.sgn;
    alias copysign      = llvm_copysign;
    alias isPowerOf2    = std.math.isPowerOf2;
    
    // Hardware Control
    alias IeeeFlags            = std.math.IeeeFlags;
    alias ieeeFlags            = std.math.ieeeFlags;
    alias resetIeeeFlags       = std.math.resetIeeeFlags;
    alias FloatingPointControl = std.math.FloatingPointControl;
}
